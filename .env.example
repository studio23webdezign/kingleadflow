# Public Supabase project settings (publishable key is safe for browser use)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical app origin for email confirmation callbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server-only secrets. Never prefix these with NEXT_PUBLIC_.
# Required for server-only Gmail OAuth token reads/writes; never expose to the browser.
SUPABASE_SECRET_KEY=

# Gemini server-side key (never expose with a NEXT_PUBLIC_ prefix).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Email integrations (server-side only; configure only after OAuth apps are created).
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Register this exact callback URL with Google: https://YOUR_DOMAIN/api/integrations/google/callback
GOOGLE_OAUTH_REDIRECT_URI=
# Generate 32 random bytes and encode as 64 hexadecimal characters.
EMAIL_TOKEN_ENCRYPTION_KEY=
